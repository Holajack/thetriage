# ── Expo client env (copy to .env.local — never commit real values) ─────────
# RevenueCat public SDK keys (RevenueCat dashboard → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Convex deployment env vars (set in the Convex dashboard, NOT here) ──────
# OPENAI_API_KEY            — OpenAI key for Patrick, ingestion, Whisper
# OPENAI_API_KEY_NEW_NORA   — optional separate OpenAI key for Nora
# CLERK_WEBHOOK_SECRET      — Clerk webhook signing secret (svix)
# REVENUECAT_WEBHOOK_TOKEN  — shared secret for /revenuecat-webhook. While set,
#                             client calls can no longer upgrade their own tier;
#                             the webhook becomes the source of truth.
# REVENUECAT_API_KEY        — optional RevenueCat secret API key; lets the
#                             webhook fetch current entitlements (recommended)
