{
  "cli": {
    "version": ">= 2.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "client-testing": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Release"
      },
      "channel": "client-testing"
    },
    "client-testing-simulator": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Release",
        "simulator": true
      },
      "channel": "client-testing"
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "autoIncrement": true
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6756673693",
        "appleTeamId": "7YMK4D784T",
        "ascApiKeyPath": "~/credentials/AuthKey_HKFQXFLWA5.p8",
        "ascApiKeyIssuerId": "${ASC_ISSUER_ID}",
        "ascApiKeyId": "${ASC_KEY_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "internal": {
      "ios": {
        "ascAppId": "6756673693",
        "appleTeamId": "7YMK4D784T",
        "ascApiKeyPath": "~/credentials/AuthKey_HKFQXFLWA5.p8",
        "ascApiKeyIssuerId": "${ASC_ISSUER_ID}",
        "ascApiKeyId": "${ASC_KEY_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "beta": {
      "ios": {
        "ascAppId": "6756673693",
        "appleTeamId": "7YMK4D784T",
        "ascApiKeyPath": "~/credentials/AuthKey_HKFQXFLWA5.p8",
        "ascApiKeyIssuerId": "${ASC_ISSUER_ID}",
        "ascApiKeyId": "${ASC_KEY_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
